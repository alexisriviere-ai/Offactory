+  host.innerHTML='<label>Client <select data-role="client" aria-label="Filtrer par client"></select></label><label>Chantier <select data-role="site" aria-label="Filtrer par chantier"></select></label><label>Fabrication <select data-role="fabrication" aria-label="Fabrication"></select></label><button type="button" data-role="new">+ Nouvelle fabrication</button><button type="button" data-role="assign">Attribuer client / chantier</button><span data-role="status" role="status"></span>';
