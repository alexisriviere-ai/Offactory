diff --git a/scripts/audit-test-pdfs.py b/scripts/audit-test-pdfs.py
new file mode 100644
index 0000000000000000000000000000000000000000..cf355ec5ad5c485543044ad64905b8c9f92b0391
--- /dev/null
+++ b/scripts/audit-test-pdfs.py
@@ -0,0 +1,33 @@
+"""Optional PDF QA: Python + PyMuPDF. Run after server tests and UI tests."""
+import json
+import re
+from pathlib import Path
+import pymupdf
+
+root = Path('test-artifacts')
+result = []
+for path in sorted(root.glob('*.pdf')):
+    doc = pymupdf.open(path)
+    for number, page in enumerate(doc, 1):
+        assert page.get_text().strip(), (path.name, number, 'blank page')
+        assert page.get_drawings(), (path.name, number, 'missing vector views')
+        assert not page.get_images(), (path.name, number, 'unexpected raster image')
+        for block in page.get_text('blocks'):
+            assert block[0] >= 0 and block[1] >= 0 and block[2] <= page.rect.width + 1 and block[3] <= page.rect.height + 1, (path.name, number, 'clipped text', block)
+    result.append({'file': path.name, 'pages': len(doc), 'bytes': path.stat().st_size})
+    if path.name == 'ui-vues-3d.pdf':
+        text = '\n'.join(p.get_text() for p in doc)
+        marks = re.findall(r'\b([A-Z]+\d+) / ', text)
+        assert len(marks) == 2 and marks[0].startswith('C') and marks[1].startswith('G'), marks
+    if path.name == 'ui-fiches-detaillees.pdf':
+        marks = [re.search(r'Repère\s*:\s*(\w+)', p.get_text()).group(1) for p in doc]
+        assert len(marks) == 2 and marks[0].startswith('C') and marks[1].startswith('G'), marks
+    # Render every family example page for a visual review, including the new
+    # elbow outline and the original detailed fabrication header.
+    if path.name in ['vues-3d-familles.pdf', 'fiches-detaillees-familles.pdf']:
+        out = root / 'rendered'
+        out.mkdir(exist_ok=True)
+        for i, page in enumerate(doc):
+            page.get_pixmap(matrix=pymupdf.Matrix(1.3, 1.3), alpha=False).save(out / f'{path.stem}-{i+1}.png')
+print(json.dumps(result, indent=2))
+(root / 'pdf-audit.json').write_text(json.dumps(result, indent=2), encoding='utf-8')
