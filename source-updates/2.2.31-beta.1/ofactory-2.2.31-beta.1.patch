+export async function organizationRequest(data,fetcher=globalThis.fetch){
+  const response=await fetcher('/api/local/organization',{method:data?'POST':'GET',headers:{'Content-Type':'application/json','X-Plenum-Local':'1'},...(data?{body:JSON.stringify(data)}:{})});
+  const result=await response.json();if(!response.ok)throw Error(result.message||'Organisation indisponible.');return result;
+}
+export const fabricationLabel=f=>`${f.clientName||'Client à attribuer'} / ${f.siteName||'Chantier à attribuer'} / ${f.name} · ${f.createdAt?new Date(f.createdAt).toLocaleString('fr-FR'):'Date inconnue'}`;
+
+// Shared native controls: used by the iframe and the React assembly screen.
+// All text from the database is assigned via textContent/value.
