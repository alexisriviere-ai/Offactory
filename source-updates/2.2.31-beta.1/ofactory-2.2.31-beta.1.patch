+// Optional, pure suggestions. No calls to manufacturing formulae, no mutation.
+// Changes to dimensions invalidate both a check and its individual dismissals.
+export const coherenceFingerprint=parts=>JSON.stringify(parts.map(p=>[p.id,p.type,p.dims]).sort((a,b)=>a[0].localeCompare(b[0])));
+export const assemblyCheckFingerprint=doc=>JSON.stringify([coherenceFingerprint(doc.sources),doc.nodes.map(n=>[n.id,n.sourceId,n.part.type,n.part.dims,n.extraPorts]),doc.connections]);
+export function checkCoherence(parts,{connections=[],nodes=[],portsForNode=()=>[],sectionCompatibility=null}={}){
+  const warnings=[];
+  const add=(p,rule,reason,compared,fields,level='suspicion',other=null)=>{
+    warnings.push({id:JSON.stringify([p.id,rule,compared,other]),partId:p.id,repere:p.repere,rule,reason,compared,fields,level,other});
+  };
+  for(const p of parts){const d=p.dims;
+    if(['coude90','coude'].includes(p.type)&&[d.A,d.B,d.C].every(n=>Number.isFinite(n)&&n>0)&&d.A!==d.B)
+      add(p,'elbow','Les dimensions d’entrée et de sortie sont différentes. Vérifiez qu’il s’agit bien d’un coude transformé.',`${d.C} × ${d.A} / ${d.C} × ${d.B} mm`,['A','B','C']);
+  }
+  for(const c of connections){
+    const a=nodes.find(n=>n.id===c.a.node),b=nodes.find(n=>n.id===c.b.node);if(!a||!b)continue;
+    const pa=portsForNode(a).find(p=>p.id===c.a.port),pb=portsForNode(b).find(p=>p.id===c.b.port);if(!pa||!pb)continue;
+    const valid=p=>p.shape==='round'?Number.isFinite(p.d)&&p.d>0:p.shape==='rect'&&[p.w,p.h].every(n=>Number.isFinite(n)&&n>0);
+    if(!valid(pa)||!valid(pb))continue;
+    const dimensions=p=>p.shape==='round'?`Ø ${p.d}`:`${p.w} × ${p.h}`;
+    // Use the assembly engine's existing size tolerance when supplied.
+    const compatible=sectionCompatibility?sectionCompatibility(pa,pb).ok:pa.shape===pb.shape&&(pa.shape==='round'?Math.abs(pa.d-pb.d)<=.5:
+      (Math.abs(pa.w-pb.w)<=.5&&Math.abs(pa.h-pb.h)<=.5)||(Math.abs(pa.w-pb.h)<=.5&&Math.abs(pa.h-pb.w)<=.5));
+    if(!compatible){for(const [n,other] of [[a,b],[b,a]]){const p=parts.find(p=>p.id===(n.sourceId||n.part.id));if(p)add(p,'connection','Dimensions de raccordement à vérifier.',`${dimensions(pa)} / ${dimensions(pb)} mm`,['Raccord '+(n===a?c.a.port:c.b.port)],'incompatibilité',other.part.repere);}}
+  }
+  // Deliberately conservative: at least five comparable straight rectangular
+  // ducts; flag a single extreme section only against a stable central group.
+  const group=parts.filter(p=>p.type==='gaine'&&[p.dims.A,p.dims.B].every(n=>Number.isFinite(n)&&n>0));
+  if(group.length>=5){const areas=group.map(p=>p.dims.A*p.dims.B).sort((a,b)=>a-b),median=areas[Math.floor(areas.length/2)],central=areas.filter(a=>a>=median/1.5&&a<=median*1.5);
+    if(central.length>=group.length*.75)for(const p of group){const a=p.dims.A*p.dims.B;if(a>median*9||a<median/9)add(p,'atypical','Section atypique parmi les gaines droites : simple suggestion de vérification.',`${p.dims.A} × ${p.dims.B} mm ; surface médiane ${median} mm²`,['A','B']);}
+  }
+  return [...new Map(warnings.map(w=>[w.id,w])).values()];
+}
