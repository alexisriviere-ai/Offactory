+  document.body.append(dialog);const form=dialog.querySelector('form'),field=n=>form.elements.namedItem(n),error=dialog.querySelector('[data-error]');
+  let registry=null,busy=false,requestId=null,assigning=false,disposed=false;
+  const clientLabel=c=>c.name+(registry.clients.filter(v=>v.name.normalize('NFKC').toLocaleLowerCase('fr')===c.name.normalize('NFKC').toLocaleLowerCase('fr')).length>1?' · '+c.id.slice(0,8):'');
+  const option=(select,label,value)=>{const o=document.createElement('option');o.value=value;o.textContent=label;select.append(o);};
+  const selectedFabrication=()=>registry?.fabrications.find(f=>f.id===getCurrent().organization?.fabricationId||f.keys?.[module]===getCurrent().workspaceKey);
