+.organization{display:flex;flex-wrap:wrap;gap:8px;align-items:end;padding:10px;background:#f2f6f8;color:#213746;border-bottom:1px solid #d4dfe5}
+.organization label{display:flex;flex-direction:column;gap:4px;font-size:12px;min-width:130px;max-width:100%}
+.organization select{max-width:min(650px,85vw);padding:7px;border:1px solid #b9cbd5;border-radius:5px;background:white;color:#213746}
+.organization [data-role=fabrication]{width:min(650px,85vw)}
+.organization button,.organization-dialog button{padding:8px 12px;border:1px solid #b9cbd5;border-radius:5px;background:white;color:#213746;cursor:pointer}
+.organization [data-role=status]{flex-basis:100%;font-size:11px;color:#4a6171}
+.organization-dialog{border:1px solid #a8becb;border-radius:10px;padding:22px;width:min(560px,90vw);max-height:90vh;overflow:auto;color:#213746;background:white}
+.organization-dialog::backdrop{background:#102d4966}
+.organization-dialog form{display:grid;gap:12px}
+.organization-dialog label{display:flex;flex-direction:column;gap:4px;font-size:13px}
+.organization-dialog input:not([type=checkbox]),.organization-dialog select{padding:8px;border:1px solid #b9cbd5;border-radius:5px;min-width:0;width:100%;box-sizing:border-box}
+.organization-dialog label:has(input[type=checkbox]){flex-direction:row;align-items:start}
+.organization-dialog [data-error]{color:#9b251b;white-space:pre-wrap}
+.organization-dialog .actions{display:flex;justify-content:end;gap:8px}
+.organization-dialog button.primary{background:#174c69;color:white}
+.piece-tools{display:flex;gap:4px;flex-wrap:wrap;padding:8px}.piece-tools button{font-size:11px;padding:7px}
+#coherence-state{font-size:11px;padding:0 10px;color:#567}
+#coherence-dialog{max-width:700px;max-height:85vh;overflow:auto}
+#coherence-results article{padding:10px 0;border-bottom:1px solid #ddd}
+#coherence-results button{margin:5px}
