@@ -0,0 +1,6 @@
+export function movePart(parts,id,direction){
+  if(![-1,1].includes(direction))return parts;
+  const from=parts.findIndex(p=>p.id===id),to=from+direction;
+  if(from<0||to<0||to>=parts.length)return parts;
+  const next=parts.slice();[next[from],next[to]]=[next[to],next[from]];return next;
+}
