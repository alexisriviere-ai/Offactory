+import {jsPDF} from 'jspdf';
+import {partModel,projection} from './geometry.mjs';
+import {TYPES,FIELDS,errors} from '../../../public/gaine-rectangulaire/engine.mjs';
+
+const clean=value=>String(value??'').replace(/×/g,' x ').replace(/→/g,' > ').replace(/−/g,'-').replace(/[\u2000-\u200f\u202f]/g,' ');
+const simple=new Set(['gaine','cadreLibre','bouchon','bouchonGrillage','piquage','manchette']);
+const titles={iso:'Isométrique',front:'Face',top:'Dessus',side:'Côté'};
+function outlineLines(part,model){
+  if(!['coude','coude90'].includes(part.type))return model.lines;
+  const ring=model.lines[0],count=ring.length-1;
+  // The solid already contains the curved profile. Its tessellation seams are
+  // not physical folds: retain the profile and sharp edges, omit smooth seams.
+  return model.lines.filter((line,index)=>{
+    if(index<2)return true;
+    const i=ring.findIndex(p=>p===line[0]);if(i<0)return true;
+    const prev=ring[(i+count-1)%count],p=ring[i],next=ring[(i+1)%count];
+    const a=p.map((v,j)=>v-prev[j]),b=next.map((v,j)=>v-p[j]),den=Math.hypot(...a)*Math.hypot(...b);
+    return !den||a.reduce((sum,v,j)=>sum+v*b[j],0)/den<Math.cos(Math.PI/12);
+  });
+}
+
+// Geometry is shared with the assembly engine. Only projection and layout live
+// here: no alternate solids, camera screenshots, images or interactive 3D.
+export function makePartPdf(parts,meta={},PDF=jsPDF){
+  if(!parts.length)throw Error('Ajoutez une pièce avant d’exporter.');
+  for(const p of parts){const es=errors(p);if(es.length)throw Error(`${p.repere} : ${es[0]}`);}
+  const pdf=new PDF({orientation:'landscape',unit:'mm',format:'a4',compress:true,putOnlyUsedFonts:true,floatPrecision:3});
+  pdf.setProperties({title:clean(`Vues 3D - ${meta.reference||'Fabrication'}`),subject:'Vues statiques vectorielles par pièce',author:'OF FACTORY'});
+  const text=(s,x,y,size=8,bold=false,width)=>{pdf.setFont('helvetica',bold?'bold':'normal');pdf.setFontSize(size);pdf.setTextColor(30,47,61);pdf.text(width?pdf.splitTextToSize(clean(s),width):clean(s),x,y);};
+  const date=new Date().toLocaleString('fr-FR');
+  let index=0,page=0;
+  const layout=[];
+  while(index<parts.length){
+    if(page++)pdf.addPage();
+    text('OF FACTORY / VISUALISATION DES PIÈCES',10,10,11,true);
+    text(`Client : ${meta.clientName||'À attribuer'}`,10,16,8,false,275);
+    text(`Chantier : ${meta.siteName||'À attribuer'} / Fabrication : ${meta.reference||'Sans référence'}`,10,22,8,false,275);
+    text(`Création fabrication : ${meta.createdAt?new Date(meta.createdAt).toLocaleString('fr-FR'):'inconnue'} / Édition : ${date}`,10,32,7);
+    const batch=parts.slice(index,index+3),count=batch.length===3&&batch.every(p=>simple.has(p.type))?3:Math.min(2,parts.length-index),rowHeight=160/count;
+    for(let row=0;row<count;row++){
+      const p=parts[index++],model=partModel(p),lines=outlineLines(p,model),y=37+row*rowHeight,modes=simple.has(p.type)?['iso','front','side']:['iso','front','top','side'];
+      pdf.setDrawColor(188,202,211);pdf.setLineWidth(.15);pdf.line(10,y,287,y);
+      text(`${p.repere} / ${TYPES[p.type]} / Quantité ${p.qty}`,11,y+5,9,true);
+      const dims=FIELDS[p.type].map(f=>`${f.key} ${p.dims[f.key]}`).join(' / ');
+      text(`Dimensions (mm) : ${dims}`,11,y+10,7,false,274);
+      const cellW=276/modes.length,viewY=y+17,viewH=rowHeight-19;
+      modes.forEach((mode,col)=>{
+        const x=11+col*cellW,project=projection(mode),points=model.lines.flat().map(project);
+        if(!points.length)throw Error(`Géométrie indisponible : ${p.repere}`);
+        const xs=points.map(p=>p[0]),ys=points.map(p=>p[1]),x0=Math.min(...xs),x1=Math.max(...xs),y0=Math.min(...ys),y1=Math.max(...ys);
+        const scale=Math.min((cellW-10)/Math.max(1,x1-x0),(viewH-10)/Math.max(1,y1-y0));
+        const map=p=>{const a=project(p);return [x+cellW/2+(a[0]-(x0+x1)/2)*scale,viewY+5+(viewH-5)/2+(a[1]-(y0+y1)/2)*scale];};
+        text(titles[mode],x+3,viewY+2,7);
+        pdf.setFillColor(235,241,244);pdf.setDrawColor(130,151,165);pdf.setLineWidth(.1);
+        const faces=model.triangles.map(t=>({t,depth:t.reduce((sum,p)=>sum+project(p)[2]/3,0)})).sort((a,b)=>a.depth-b.depth);
+        for(const {t} of faces){const a=t.map(map);pdf.triangle(...a[0],...a[1],...a[2],'F');}
+        pdf.setDrawColor(45,74,93);pdf.setLineWidth(.18);
+        for(const line of lines){const a=line.map(map);for(let i=1;i<a.length;i++)pdf.line(...a[i-1],...a[i]);}
+        const mapped=points.map(p=>[x+cellW/2+(p[0]-(x0+x1)/2)*scale,viewY+5+(viewH-5)/2+(p[1]-(y0+y1)/2)*scale]);
+        layout.push({repere:p.repere,page,mode,box:[x,viewY,cellW,viewH],bounds:[Math.min(...mapped.map(p=>p[0])),Math.min(...mapped.map(p=>p[1])),Math.max(...mapped.map(p=>p[0])),Math.max(...mapped.map(p=>p[1]))]});
+      });
+    }
+  }
