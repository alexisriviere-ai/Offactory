+import {randomUUID} from 'node:crypto';
+
+export const workspaceTypes=['RectangularDuctWorkspace','AssemblyWorkspace'];
+const reject=message=>{throw Object.assign(Error(message),{status:400});};
+export const normalizeName=name=>String(name??'').normalize('NFKC').trim().replace(/\s+/g,' ').toLocaleLowerCase('fr');
+const name=value=>{if(typeof value!=='string'||!value.trim()||value.trim().length>80)reject('Nom requis (80 caractères maximum).');return value.trim().replace(/\s+/g,' ');};
+
+// No inference from an old reference, even when both modules used "main".
+// Binding to immutable record IDs keeps legacy workspaces independent.
+export function migrateOrganization(db){
+  db.OfClients??=[];db.OfSites??=[];db.OfFabrications??=[];
+  for(const type of workspaceTypes)for(const row of db[type]||[]){
+    if(db.OfFabrications.some(f=>f.bindings?.[type]===row.id))continue;
+    const linked=db.OfFabrications.find(f=>f.id===row.document?.organization?.fabricationId);
+    if(linked){linked.bindings[type]=row.id;continue;}
+    db.OfFabrications.push({id:`legacy-${type}-${row.id}`,name:row.name||'Affaire sans nom',clientId:null,siteId:null,
+      createdAt:row.created_date||null,updatedAt:row.updated_date||row.created_date||null,bindings:{[type]:row.id},
+      keys:{[type]:row.workspaceKey},unassigned:true});
+  }
+  db.OrganizationVersion=1;
+  return db;
+}
+export function organizationView(db){
+  migrateOrganization(db);
+  return {version:1,clients:db.OfClients,sites:db.OfSites,fabrications:db.OfFabrications.map(f=>({...f,
+    clientName:db.OfClients.find(c=>c.id===f.clientId)?.name||'',siteName:db.OfSites.find(s=>s.id===f.siteId)?.name||''}))};
+}
+export function organizationMeta(db,f){return {fabricationId:f.id,clientId:f.clientId,siteId:f.siteId,
+  clientName:db.OfClients.find(c=>c.id===f.clientId)?.name||'',siteName:db.OfSites.find(s=>s.id===f.siteId)?.name||'',createdAt:f.createdAt};}
+export function createFabrication(db,input,now=new Date().toISOString()){
+  migrateOrganization(db);
+  const existing=db.OfFabrications.find(f=>f.id===input.requestId);if(existing)return existing;
+  if(typeof input.requestId!=='string'||!/^affaire-[a-zA-Z0-9-]{1,80}$/.test(input.requestId))reject('Identifiant de validation invalide.');
+  let client=db.OfClients.find(c=>c.id===input.clientId);
+  if(!client){
+    if(input.clientId)reject('Client introuvable.');
+    const clientName=name(input.clientName),matches=db.OfClients.filter(c=>normalizeName(c.name)===normalizeName(clientName));
+    if(matches.length>1&&!input.distinctClient)reject('Plusieurs clients portent ce nom : sélectionnez le client existant ou cochez « client distinct ».');
+    if(matches.length&&!input.distinctClient)client=matches[0];
+    else{client={id:randomUUID(),name:clientName,createdAt:now};db.OfClients.push(client);}
+  }
+  let site=db.OfSites.find(s=>s.id===input.siteId&&s.clientId===client.id);
+  if(!site){
+    if(input.siteId)reject('Ce chantier ne dépend pas du client sélectionné.');
+    const siteName=name(input.siteName);site=db.OfSites.find(s=>s.clientId===client.id&&normalizeName(s.name)===normalizeName(siteName));
+    if(!site){site={id:randomUUID(),name:siteName,clientId:client.id,createdAt:now};db.OfSites.push(site);}
+  }
+  const f={id:input.requestId,name:name(input.name||site.name),clientId:client.id,siteId:site.id,createdAt:now,updatedAt:now,
+    bindings:{},keys:Object.fromEntries(workspaceTypes.map(t=>[t,input.requestId])),unassigned:false};
+  db.OfFabrications.push(f);return f;
+}
+export function assignFabrication(db,input){
+  const target=db.OfFabrications.find(f=>f.id===input.fabricationId);if(!target)reject('Fabrication introuvable.');
+  const helper=createFabrication(db,{...input,requestId:`affaire-${randomUUID()}`});
+  target.clientId=helper.clientId;target.siteId=helper.siteId;target.unassigned=false;
+  db.OfFabrications=db.OfFabrications.filter(f=>f!==helper);
+  // Update only identity metadata; preserve every dimension and connection.
+  for(const type of workspaceTypes){const row=db[type]?.find(r=>r.id===target.bindings[type]);if(row)row.document.organization=organizationMeta(db,target);}
+  return target;
+}
+export function bindWorkspace(db,type,row){
+  if(!workspaceTypes.includes(type))return;
+  let f=db.OfFabrications.find(f=>f.id===row.document?.organization?.fabricationId);
+  if(!f)f=db.OfFabrications.find(f=>f.bindings?.[type]===row.id);
+  if(!f)return;
+  if(f.keys[type]&&f.keys[type]!==row.workspaceKey)reject('Rattachement de fabrication incohérent.');
+  if(f.bindings[type]&&f.bindings[type]!==row.id)reject('Cette fabrication possède déjà un document dans ce module.');
+  f.bindings[type]=row.id;f.keys[type]=row.workspaceKey;f.updatedAt=row.updated_date;f.name=row.name;
+  if(row.document.organization||f.clientId)row.document.organization=organizationMeta(db,f);
+}
